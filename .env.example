# Postgres — reached over the docker-compose service network
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/legalbot
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@postgres:5432/legalbot
DATABASE_URL_PSYCOPG=postgresql://postgres:postgres@postgres:5432/legalbot

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_REDBEAT_URL=redis://redis:6379/3

# Secrets (generate with `openssl rand -hex 32`)
FERNET_KEY=
JWT_SECRET=

# LLM provider keys (pick the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent models (LangChain `init_chat_model`: `provider:model_id`)
AGENT_MODEL=anthropic:claude-sonnet-4-5
# Tiered stages (Haiku for IO-heavy work; Sonnet for orchestrator + contract fill)
EXTRACT_MODEL=anthropic:claude-haiku-4-5
ANALYZE_MODEL=anthropic:claude-haiku-4-5
ANALYZE_RESEARCH_MODEL=anthropic:claude-haiku-4-5
ANALYZE_DECIDE_MODEL=anthropic:claude-haiku-4-5
ANALYZE_MAX_RESEARCH_STEPS=12
ACT_MODEL=anthropic:claude-haiku-4-5
CONTRACT_MODEL=anthropic:claude-sonnet-4-5
CONTRACT_VALIDATION_MODEL=anthropic:claude-haiku-4-5
REFLECT_MODEL=anthropic:claude-haiku-4-5
SUMMARIZATION_MODEL=anthropic:claude-haiku-4-5
VISION_MODEL=anthropic:claude-haiku-4-5
EMBED_MODEL=openai:text-embedding-3-small
EMBED_DIMS=1536

# Cost controls
REFLECTION_ENABLED=true
READ_ARTIFACT_SUMMARY_MAX_BYTES=4096
VISION_SKIP_MAX_BYTES=8192
STAGE_RECURSION_LIMIT_DEFAULT=25
STAGE_RECURSION_LIMIT_EXTRACT_NONE=8
STAGE_RECURSION_LIMIT_EXTRACT_SMALL=12
STAGE_RECURSION_LIMIT_EXTRACT_LARGE=20

# LLM resilience (429 / transient provider errors via LangChain max_retries + rate limiter)
LLM_MAX_RETRIES=6
LLM_REQUESTS_PER_SECOND=2.0
LLM_MAX_BUCKET_SIZE=5

# Feature flags
BIGTOOL_ENABLED=false
KG_ENABLED=true
KG_LLM_EXTRACTION_ENABLED=false
KG_EXTRACTION_MODEL=anthropic:claude-haiku-4-5
KG_MERGE_TRGM_THRESHOLD=0.85

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legalbot
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=legalbot

# Blob store (local FS default)
BLOB_STORE_PATH=/var/lib/legalbot/blobs

# OpenAI-only dev example (when Anthropic credits are low):
# AGENT_MODEL=openai:gpt-4o-mini
# EXTRACT_MODEL=openai:gpt-4o-mini
# ANALYZE_MODEL=openai:gpt-4o-mini

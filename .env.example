# Postgres — reached over the docker-compose service network
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/legalbot
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@postgres:5432/legalbot
DATABASE_URL_PSYCOPG=postgresql://postgres:postgres@postgres:5432/legalbot

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_REDBEAT_URL=redis://redis:6379/3

# Secrets (generate with `openssl rand -hex 32`)
FERNET_KEY=
JWT_SECRET=

# LLM provider keys (pick the ones you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent models (LangChain `init_chat_model`: `provider:model_id`)
AGENT_MODEL=anthropic:claude-sonnet-4-5
# OpenAI stack example: AGENT_MODEL=openai:gpt-5.4-mini
SUMMARIZATION_MODEL=anthropic:claude-haiku-4-5
EMBED_MODEL=openai:text-embedding-3-small
EMBED_DIMS=1536

# Feature flags
BIGTOOL_ENABLED=false

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legalbot
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=legalbot

# Blob store (local FS default)
BLOB_STORE_PATH=/var/lib/legalbot/blobs
